{
  "name": "openphysics-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A free, open-source, dependency-linked physics reference.",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:content && astro build",
    "deploy": "npm run build && wrangler deploy",
    "search:serve": "pagefind --serve",
    "preview": "astro preview",
    "check": "npm run check:content && astro check",
    "check:content": "tsx scripts/check-content.ts",
    "test": "tsx --test tests/*.test.ts",
    "astro": "astro"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@pagefind/component-ui": "^1.6.0",
    "astro": "^7.4.13",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "katex": "^0.19.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.10.0",
    "pagefind": "^1.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "wrangler": "^4.168.0"
  }
}
