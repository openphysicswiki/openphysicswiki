---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import { SITE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const { title, description = SITE.description, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · Physics from first principles`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121516" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          const theme = saved === "light" || saved === "dark"
            ? saved
            : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class:list={["container", "header-inner", { wide }]}>
        <a class="wordmark" href="/" aria-label="openphysics.wiki home">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M8 8 24 8 16 25Z" fill="none" stroke="currentColor" stroke-width="1.5" />
            <circle cx="8" cy="8" r="3" />
            <circle cx="24" cy="8" r="3" />
            <circle cx="16" cy="25" r="3" />
          </svg>
          <span>openphysics<span class="wordmark-dot">.wiki</span></span>
        </a>
        <nav class="header-nav" aria-label="Main navigation">
          <a href="/about/">About</a>
          <a href="/contribute/">Contribute</a>
          <button class="theme-toggle" type="button" aria-label="Switch color theme">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2v2m0 12v2M2 10h2m12 0h2M4.35 4.35l1.4 1.4m8.5 8.5 1.4 1.4m0-11.3-1.4 1.4m-8.5 8.5-1.4 1.4" fill="none" stroke="currentColor" stroke-width="1.4" /><circle cx="10" cy="10" r="3.4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            <span data-theme-label>Theme</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main-content" class:list={["container", { wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class:list={["container", "footer-inner", { wide }]}>
        <p>Open by default. No tracking. No advertising.</p>
        <nav aria-label="Legal and project links">
          <a href="/license/"><span>MIT code</span> · <span>CC BY-SA 4.0 content</span></a>
          {SITE.repositoryUrl && <a href={SITE.repositoryUrl}>Source</a>}
        </nav>
      </div>
    </footer>

    <script>
      const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const label = document.querySelector<HTMLElement>("[data-theme-label]");
      const syncLabel = () => {
        const current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
        if (label) label.textContent = current === "dark" ? "Light" : "Dark";
        button?.setAttribute("aria-label", `Switch to ${current === "dark" ? "light" : "dark"} theme`);
      };
      syncLabel();
      button?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        syncLabel();
      });
    </script>
  </body>
</html>

<style>
  .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 4.8rem; gap: 1rem; }
  .site-header { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 92%, transparent); }
  .wordmark { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--text); font-size: 0.98rem; font-weight: 720; letter-spacing: -0.025em; text-decoration: none; }
  .brand-mark { width: 1.7rem; height: 1.7rem; color: var(--accent); fill: currentColor; }
  .wordmark-dot { color: var(--muted); font-weight: 550; }
  .header-nav { display: flex; align-items: center; gap: 1.25rem; font-size: 0.83rem; }
  .header-nav > a { color: var(--muted); text-decoration: none; }
  .header-nav > a:hover { color: var(--text); }
  .theme-toggle { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.55rem; border: 1px solid var(--line); border-radius: 0.4rem; background: transparent; color: var(--muted); cursor: pointer; font: inherit; }
  .theme-toggle:hover { color: var(--text); border-color: var(--faint); }
  .theme-toggle svg { width: 1rem; height: 1rem; }
  .site-footer { margin-top: 6rem; border-top: 1px solid var(--line); }
  .footer-inner { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.7rem; color: var(--muted); font-size: 0.75rem; }
  .footer-inner p { margin: 0; }
  .footer-inner nav { display: flex; gap: 1rem; }
  .footer-inner a { color: inherit; text-decoration: none; }
  .footer-inner a:hover { color: var(--text); }
  @media (max-width: 620px) {
    .header-nav { gap: 0.75rem; }
    .header-nav > a:first-child { display: none; }
    .wordmark { font-size: 0.88rem; }
    .footer-inner { flex-direction: column; }
  }
</style>
