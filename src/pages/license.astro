---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---
<BaseLayout title="Licences" description="MIT for code; CC BY-SA 4.0 for physics content.">
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Licences" }]} />
  <article class="license-page">
    <p class="eyebrow">Open by default</p>
    <h1>Licences</h1>
    <p class="lede">Use, adapt, and share the project within the terms of its two open licences.</p>
    <section>
      <h2>Code · MIT</h2>
      <p>The site, build tooling, graph code, and validation scripts are licensed under the MIT License. The complete terms are in the repository's <code>LICENSE</code> file.</p>
      <a href="https://opensource.org/license/mit" rel="external">Canonical MIT license text ↗</a>
    </section>
    <section>
      <h2>Content · CC BY-SA 4.0</h2>
      <p>Entry text, equations, and original explanatory material are licensed under Creative Commons Attribution-ShareAlike 4.0 International. Attribute openphysics.wiki and its contributors, and distribute adaptations under the same licence.</p>
      <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="external">Read CC BY-SA 4.0 ↗</a>
    </section>
    <p class="license-note">This page is a summary, not a substitute for either licence. Individual contributions are made under these same terms.</p>
  </article>
</BaseLayout>

<style>
  .license-page { max-width: 47rem; padding-top: 1.5rem; }
  h1 { font-family: var(--font-serif); font-weight: 550; }
  section { margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  section h2 { font-size: 1.2rem; }
  section p, .license-note { color: var(--muted); font-size: 0.9rem; line-height: 1.75; }
  section a { font-size: 0.82rem; }
  code { background: var(--surface-subtle); font-family: var(--font-mono); font-size: 0.85em; }
  .license-note { margin-top: 3rem; font-size: 0.75rem; }
</style>
