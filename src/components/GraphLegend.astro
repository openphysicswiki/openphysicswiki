---
import { ENTRY_TYPES } from "../data/site";
---
<div class="graph-legend" aria-label="Entry type legend">
  {ENTRY_TYPES.map((type) => (
    <span class={`legend-item type-${type.id}`}>
      <svg viewBox="0 0 28 20" aria-hidden="true">
        {type.id === "theorem" ? <rect x="2" y="3" width="24" height="14" rx="7" /> :
          type.id === "axiom" ? <path d="M7 3h14l5 7-5 7H7l-5-7Z" /> :
          type.id === "principle" ? <path d="m8 3-6 7 6 7h12l6-7-6-7Z" /> :
          type.id === "technique" ? <rect class="dashed" x="2" y="3" width="24" height="14" /> :
          type.id === "example" ? <path d="m7 3-5 4v6l5 4h14l5-4V7l-5-4Z" /> :
          <rect x="2" y="3" width="24" height="14" rx="1" />}
      </svg>
      <span class="legend-code" aria-hidden="true">{type.code}</span>{type.label}
    </span>
  ))}
  <span class="legend-item foundation-key"><span class="foundation-symbol" aria-hidden="true">◆</span> Foundational</span>
</div>

<style>
  .graph-legend { display: flex; flex-wrap: wrap; gap: 0.65rem 1rem; color: var(--muted); font-size: 0.72rem; }
  .legend-item { --badge: var(--text); display: inline-flex; align-items: center; gap: 0.28rem; }
  .legend-item svg { width: 1.55rem; height: 1.15rem; fill: color-mix(in srgb, var(--badge) 12%, var(--surface)); stroke: var(--badge); stroke-width: 1.5; }
  .legend-item .dashed { stroke-dasharray: 3 2; }
  .legend-code { color: var(--badge); font-family: var(--font-mono); font-weight: 750; }
  .type-definition { --badge: var(--type-definition); }
  .type-axiom { --badge: var(--type-axiom); }
  .type-principle { --badge: var(--type-principle); }
  .type-theorem { --badge: var(--type-theorem); }
  .type-technique { --badge: var(--type-technique); }
  .type-example { --badge: var(--type-example); }
  .foundation-symbol { color: var(--accent); font-size: 0.65rem; }
  .foundation-key { margin-left: 0.25rem; padding-left: 1rem; border-left: 1px solid var(--line); }
</style>
